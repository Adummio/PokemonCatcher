@page "/incontro-casuale"
@using Pokemon.Core
@using BlazorWebApp.Services
@inject IPokemonService PokemonService
@inject IPokedexClientService PokedexService

@rendermode InteractiveServer

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">

            @if (loading)
            {
                <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 300px;">
                    <div class="spinner-border text-secondary mb-3" role="status"></div>
                    <p class="text-secondary">Cercando nell'erba alta...</p>
                </div>
            }
            else if (isCaught)
            {
                <div class="success-view py-5 animate-fade-in">
                    <div class="mb-4">
                        @* Icona grande verde *@
                        <i class="fas fa-check-circle text-success fa-5x mb-3 animate-bounce"></i>
                        
                        @* Testo Scuro (Nero/Grigio scuro) per essere visibile sullo sfondo chiaro *@
                        <h2 class="text-dark fw-bold mb-2">Ottimo lavoro!</h2>
                        <h4 class="text-secondary mb-4">Complimenti, hai catturato <strong>@lastCapturedName</strong>!</h4>
                    </div>
                    
                    @* Pulsante colorato *@
                    <button class="btn btn-lg btn-primary px-5 shadow-lg fw-bold" @onclick="GeneraNuovoIncontro">
                        <i class="fas fa-play"></i> Prossimo Pokémon
                    </button>
                </div>
            }
            else if (pokemon != null)
            {
                <div class="pokemon-card shadow-lg mx-auto mb-4 animate-fade-in">
                    <div class="card-header-custom p-3">
                        <span class="pokedex-id">#@pokemon.Id.ToString("D3")</span>
                        <h2 class="pokemon-name">@pokemon.Name?.ToUpper()</h2>
                    </div>

                    <div class="image-container p-4">
                        <img src="@(pokemon.Sprites?.Other?.OfficialArtwork?.FrontDefault ?? pokemon.Sprites?.FrontDefault)" 
                             class="img-fluid pokemon-img" alt="@pokemon.Name" />
                    </div>

                    <div class="card-footer-custom p-3">
                        <div class="d-flex justify-content-center gap-2 mb-3">
                            @foreach (var type in pokemon.Types ?? [])
                            {
                                <span class="type-badge @type.Type?.Name?.ToLower()">
                                    @type.Type?.Name?.ToUpper()
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-3">
                    <button class="btn btn-lg btn-danger px-4 shadow" @onclick="CatturaPokemon" disabled="@isCapturing">
                        @if (isCapturing)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <i class="fas fa-circle-dot"></i> <span> Cattura</span>
                        }
                    </button>

                    <button class="btn btn-lg btn-outline-secondary text-white px-4" @onclick="GeneraNuovoIncontro" disabled="@isCapturing">
                        <i class="fas fa-person-running"></i> Fuggi
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(captureMessage))
                {
                    <div class="alert @(isCaught ? "alert-success" : "alert-warning") mt-3 animate-fade-in">
                        @captureMessage
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    /* Includi il CSS precedente qui */
    .pokemon-card { background: #1a1a1a; border-radius: 20px; border: 1px solid #333; overflow: hidden; max-width: 400px; }
    .card-header-custom { background: rgba(255,255,255,0.05); }
    .pokemon-name { color: white; letter-spacing: 2px; }
    .pokemon-img { max-height: 250px; filter: drop-shadow(0 10px 15px rgba(0,0,0,0.5)); }
    .type-badge { padding: 5px 15px; border-radius: 50px; font-size: 0.75rem; font-weight: bold; color: white; }
    
    /* Colori Tipi */
    .fire { background: #ff4422; } .water { background: #3399ff; } .grass { background: #77cc55; }
    .electric { background: #ffcc33; color: black; } .normal { background: #aaaa99; }
    
    /* Animazioni */
    .animate-fade-in { animation: fadeIn 0.5s ease-in; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .animate-bounce { animation: bounce 2s infinite; }
    @@keyframes bounce { 0%, 20%, 50%, 80%, 100% {transform: translateY(0);} 40% {transform: translateY(-20px);} 60% {transform: translateY(-10px);} }
</style>

@code {
    private PokemonModel? pokemon;
    private bool loading = false;
    private bool isCapturing = false;
    private bool isCaught = false; // Stato critico per il flusso
    private string? captureMessage;
    private string? lastCapturedName;

    private string trainerId = "AshKetchum";

    protected override async Task OnInitializedAsync()
    {
        await GeneraNuovoIncontro();
    }

    private async Task GeneraNuovoIncontro()
    {
        loading = true;
        isCaught = false; // Resetta lo stato di cattura per il nuovo incontro
        captureMessage = null;
        pokemon = await PokemonService.GetRandomPokemonAsync();
        loading = false;
    }

    private async Task CatturaPokemon()
    {
        if (pokemon == null) return;

        isCapturing = true;
        captureMessage = "Lancio della Poké Ball...";
        
        await Task.Delay(1500); // Suspense

        // Probabilità di cattura (50%)
        var successo = new Random().Next(0, 2) == 0;

        if (successo)
        {
            
            var salvato = await PokedexService.SalvaPokemonAsync(trainerId, pokemon);

            if (salvato)
            {
                lastCapturedName = pokemon.Name?.ToUpper();
                isCaught = true;
                captureMessage = $"Hai catturato {lastCapturedName}!";
            }
            else
            {
                captureMessage = "Errore di comunicazione con il server di salvataggio.";
            }
            
            // TODO: Inserire qui la chiamata POST alla Minimal API per il salvataggio in memoria
        }
        else
        {
            captureMessage = "Oh no! Il Pokémon si è liberato!";
            // La card rimane visibile perché isCaught resta false
        }

        isCapturing = false;
        StateHasChanged();
    }
}