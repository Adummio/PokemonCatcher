@page "/incontro-casuale"
@using Pokemon.Core
@using BlazorWebApp.Services
@inject IPokemonService PokemonService
@rendermode InteractiveServer

<button class="btn btn-primary" @onclick="Load">Carica Pokemon</button>

@if (pokemon != null)
{
    <h4>@pokemon.Name</h4>
}

@code {
    private PokemonModel? pokemon;

    private async Task Load()
    {
        // Tutta la logica complessa è nascosta nel service!
        pokemon = await PokemonService.GetRandomPokemonAsync();
    }
}